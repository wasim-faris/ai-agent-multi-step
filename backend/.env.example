# Environment variables for the AI Product Finder backend
# Copy this file to .env and add your OpenRouter key

# Django secret key (use any long random string)
DJANGO_SECRET_KEY=django-insecure-change-this-to-something-random-in-production

# Get an API key at: https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4o-mini
